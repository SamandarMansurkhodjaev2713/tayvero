// AUTONOMOUS-R7-R8: CONFIGURABLE PIPELINE AND MIGRATION CENTER
// Additive sidecar models enable an expand/contract migration away from legacy hardcoded DealStage.
enum CrmPipelineStageType {
  OPEN
  WON
  LOST
}

enum CrmMigrationJobStatus {
  CREATED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum CrmMigrationIssueSeverity {
  WARNING
  ERROR
}

model CrmPipeline {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  slug        String
  isDefault   Boolean  @default(false) @map("is_default")
  isArchived  Boolean  @default(false) @map("is_archived")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages      CrmPipelineStage[]          @relation("PipelineStages")
  assignments          CrmDealPipelineAssignment[]    @relation("PipelineAssignments")
  legacyStageMappings CrmLegacyDealStageMapping[]    @relation("LegacyStagePipelineMappings")

  @@unique([workspaceId, id], map: "crm_pipeline_workspace_id_id_key")
  @@unique([workspaceId, slug], map: "crm_pipeline_workspace_slug_key")
  @@unique([workspaceId], map: "crm_pipeline_one_default_per_workspace_key", where: { isDefault: true, isArchived: false })
  @@index([workspaceId, isArchived], map: "crm_pipeline_workspace_archived_idx")
  @@map("crm_pipeline")
}

model CrmPipelineStage {
  id                  String               @id @default(cuid())
  workspaceId         String               @map("workspace_id")
  pipelineId          String               @map("pipeline_id")
  key                 String
  name                String
  position            Int
  stageType           CrmPipelineStageType @map("stage_type")
  probabilityBps      Int                  @map("probability_bps")
  color               String?
  allowedFromStageIds Json                 @default("[]") @map("allowed_from_stage_ids")
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  pipeline    CrmPipeline                  @relation("PipelineStages", fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Cascade, map: "crm_pipeline_stage_pipeline_fkey")
  assignments         CrmDealPipelineAssignment[] @relation("StageAssignments")
  legacyStageMappings CrmLegacyDealStageMapping[] @relation("LegacyStageMappings")

  @@unique([workspaceId, pipelineId, id], map: "crm_pipeline_stage_workspace_pipeline_id_key")
  @@unique([workspaceId, pipelineId, key], map: "crm_pipeline_stage_workspace_pipeline_key_key")
  @@unique([workspaceId, pipelineId, position], map: "crm_pipeline_stage_workspace_pipeline_position_key")
  @@index([workspaceId, pipelineId, stageType], map: "crm_pipeline_stage_type_idx")
  @@map("crm_pipeline_stage")
}

model CrmDealPipelineAssignment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  dealId      String   @map("deal_id")
  pipelineId  String   @map("pipeline_id")
  stageId     String   @map("stage_id")
  version     Int      @default(1)
  enteredAt   DateTime @default(now()) @map("entered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipeline CrmPipeline      @relation("PipelineAssignments", fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Restrict, map: "crm_deal_pipeline_assignment_pipeline_fkey")
  stage    CrmPipelineStage @relation("StageAssignments", fields: [workspaceId, pipelineId, stageId], references: [workspaceId, pipelineId, id], onDelete: Restrict, map: "crm_deal_pipeline_assignment_stage_fkey")

  @@unique([workspaceId, dealId], map: "crm_deal_pipeline_assignment_workspace_deal_key")
  @@index([workspaceId, pipelineId, stageId], map: "crm_deal_pipeline_assignment_stage_idx")
  @@index([workspaceId, enteredAt], map: "crm_deal_pipeline_assignment_entered_idx")
  @@map("crm_deal_pipeline_assignment")
}


model CrmLegacyDealStageMapping {
  workspaceId String    @map("workspace_id")
  legacyStage DealStage @map("legacy_stage")
  pipelineId  String    @map("pipeline_id")
  stageId     String    @map("stage_id")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pipeline CrmPipeline      @relation("LegacyStagePipelineMappings", fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Restrict, map: "crm_legacy_deal_stage_mapping_pipeline_fkey")
  stage    CrmPipelineStage @relation("LegacyStageMappings", fields: [workspaceId, pipelineId, stageId], references: [workspaceId, pipelineId, id], onDelete: Restrict, map: "crm_legacy_deal_stage_mapping_stage_fkey")

  @@id([workspaceId, legacyStage])
  @@index([workspaceId, pipelineId, stageId], map: "crm_legacy_deal_stage_mapping_target_idx")
  @@map("crm_legacy_deal_stage_mapping")
}

model CrmPipelineCommandReceipt {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  action         String
  idempotencyKey String   @map("idempotency_key")
  payloadHash    String   @map("payload_hash")
  resultJson     Json     @map("result_json")
