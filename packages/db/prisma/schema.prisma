  payloadHash String   @map("payload_hash")
  outcome     String
  entityId    String?  @map("entity_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt], map: "crm_pipeline_audit_workspace_created_idx")
  @@index([workspaceId, entityId, createdAt], map: "crm_pipeline_audit_entity_created_idx")
  @@index([requestId], map: "crm_pipeline_audit_request_idx")
  @@map("crm_pipeline_audit_event")
}

model CrmMigrationJob {
  backgroundEnabled Boolean @default(false) @map("background_enabled")
  backgroundRequestedById String? @map("background_requested_by_id")
  backgroundVersion Int @default(0) @map("background_version")
  backgroundNextAttemptAt DateTime? @map("background_next_attempt_at")
  backgroundFailureCount Int @default(0) @map("background_failure_count")
  backgroundLastErrorCode String? @map("background_last_error_code")
  sourceId String? @map("source_id")
  source CrmMigrationSource? @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict)
  rowReceipts CrmMigrationRowReceipt[]
  id                 String                @id @default(cuid())
  workspaceId        String                @map("workspace_id")
  createdById        String                @map("created_by_id")
  entityType         String                @map("entity_type")
  sourceFormat       String                @map("source_format")
  sourceFilename     String                @map("source_filename")
  sourceSha256       String                @map("source_sha256")
  status             CrmMigrationJobStatus @default(CREATED)
  mapping            Json?
  totalRows          Int                   @default(0) @map("total_rows")
  acceptedRows       Int                   @default(0) @map("accepted_rows")
  rejectedRows       Int                   @default(0) @map("rejected_rows")
  warningCount       Int                   @default(0) @map("warning_count")
  lastCompletedBatch Int                   @default(-1) @map("last_completed_batch")
  version            Int                   @default(1)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  batches CrmMigrationBatch[]
  issues  CrmMigrationIssue[]
  events  CrmMigrationEvent[]

  @@unique([workspaceId, id], map: "crm_migration_job_workspace_id_key")
  @@index([workspaceId, sourceSha256, entityType, createdAt], map: "crm_migration_job_source_entity_created_idx")
  @@index([workspaceId, status, createdAt], map: "crm_migration_job_status_created_idx")
  @@index([workspaceId, backgroundEnabled, backgroundNextAttemptAt], map: "crm_migration_background_due_idx")
  @@map("crm_migration_job")
}

model CrmMigrationBatch {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  jobId        String   @map("job_id")
  batchIndex   Int      @map("batch_index")
  rowStart     Int      @map("row_start")
  rowEnd       Int      @map("row_end")
  payloadSha256 String   @map("payload_sha256")
  rowCount      Int      @default(0) @map("row_count")
  status        String
  attemptCount  Int      @default(0) @map("attempt_count")
  importedCount Int      @default(0) @map("imported_count")
  rejectedCount Int      @default(0) @map("rejected_count")
  leaseOwner    String?  @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  version       Int      @default(1)
  completedAt   DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  job CrmMigrationJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade, map: "crm_migration_batch_job_fkey")

  @@unique([workspaceId, jobId, batchIndex], map: "crm_migration_batch_workspace_job_index_key")
  @@index([workspaceId, jobId, status], map: "crm_migration_batch_status_idx")
  @@index([workspaceId, jobId, status, leaseExpiresAt], map: "crm_migration_batch_lease_idx")
  @@map("crm_migration_batch")
}

model CrmMigrationIssue {
  id          String                    @id @default(cuid())
  workspaceId String                    @map("workspace_id")
  jobId       String                    @map("job_id")
  rowNumber   Int                       @map("row_number")
  severity    CrmMigrationIssueSeverity
  code        String
  field       String?
  message     String
  details     Json?
  createdAt   DateTime                  @default(now()) @map("created_at")

  job CrmMigrationJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade, map: "crm_migration_issue_job_fkey")

  @@index([workspaceId, jobId, severity, rowNumber], map: "crm_migration_issue_job_severity_row_idx")
  @@map("crm_migration_issue")
}

model CrmMigrationEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  jobId       String   @map("job_id")
  type        String
  actorId     String?  @map("actor_id")
  batchIndex  Int?     @map("batch_index")
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  job CrmMigrationJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade, map: "crm_migration_event_job_fkey")

  @@index([workspaceId, jobId, createdAt], map: "crm_migration_event_job_created_idx")
  @@index([workspaceId, type, createdAt], map: "crm_migration_event_type_created_idx")
  @@map("crm_migration_event")
}

model GovernedActionReceipt {
  id             String   @id @default(cuid())
  workspaceId    String
  actionId       String
  idempotencyKey String
  payloadDigest  String
  status         String
  leaseTokenHash String?
  leaseExpiresAt DateTime?
  attemptCount   Int      @default(0)
  resultJson     Json?
  errorCode      String?
  completedAt    DateTime?
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, actionId, idempotencyKey], map: "GovernedActionReceipt_workspace_action_key")
  @@index([workspaceId, status, leaseExpiresAt], map: "GovernedActionReceipt_workspace_status_lease")
  @@index([workspaceId, actionId, createdAt], map: "GovernedActionReceipt_workspace_action_created")
  @@index([workspaceId, payloadDigest])
}

model GovernedActionApproval {
  id            String   @id @default(cuid())
  workspaceId   String
  actionId      String
  payloadDigest String
  status        String
  requestedById String
  approvedById  String?
  consumedById  String?
  expiresAt     DateTime
  consumedAt    DateTime?
  version       Int      @default(0)
  bindingVersion  Int?
  requestKey      String?
  executionKeyHash String?
  requesterUserId String?
  requestId       String?
  correlationId   String?
  manifestVersion String?
  snapshotJson    Json?
  runId           String?
  run             AgentRun? @relation("GovernedRunApproval", fields: [runId], references: [id], onDelete: Restrict)
  decidedById     String?
  decidedAt       DateTime?
  decisionReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  continuation GovernedActionContinuation?
  @@unique([workspaceId, id])
  @@index([workspaceId, status, expiresAt], map: "GovernedActionApproval_workspace_status_expiry")
  @@index([workspaceId, actionId, payloadDigest], map: "GovernedActionApproval_workspace_action_digest")
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, runId])
}

model GovernedActionAuditEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  actionId      String
  actorId       String
  requestId     String
  correlationId String
  eventType     String
  payloadDigest String?
  detailsJson   Json
  occurredAt    DateTime @default(now())

  @@index([workspaceId, occurredAt], map: "GovernedActionAuditEvent_workspace_occurred")
  @@index([workspaceId, actionId, occurredAt], map: "GovernedActionAuditEvent_workspace_action_occurred")
  @@index([workspaceId, correlationId], map: "GovernedActionAuditEvent_workspace_correlation")
}


// Encrypted source bytes stay on the private mounted source store; never in JSON API reports.
model CrmMigrationSource {
  version Int @default(1)
  purgedAt DateTime? @map("purged_at")
  deleteRequestedById String? @map("delete_requested_by_id")
  deleteReason String? @map("delete_reason")
  lifecycleEvents CrmMigrationSourceEvent[]
  id String @id
  workspaceId String @map("workspace_id")
  createdById String @map("created_by_id")
  filename String
  mimeType String @map("mime_type")
  sha256 String
  byteLength Int @map("byte_length")
  format String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  jobs CrmMigrationJob[]
  @@unique([workspaceId, id], map: "crm_migration_source_workspace_id_key")
  @@index([workspaceId, deletedAt, createdAt], map: "crm_migration_source_lifecycle_idx")
  @@map("crm_migration_source")
}

// Every accepted source row gets a durable outcome in the SAME transaction as a CRM write.
model CrmMigrationRowReceipt {
  id String @id
  workspaceId String @map("workspace_id")
  jobId String @map("job_id")
  rowNumber Int @map("row_number")
  batchIndex Int @map("batch_index")
  fingerprint String
  entityType String @map("entity_type")
  entityId String? @map("entity_id")
  status String
  code String
  recordUpdatedAt DateTime? @map("record_updated_at")
  rolledBackAt DateTime? @map("rolled_back_at")
  createdAt DateTime @default(now()) @map("created_at")
  job CrmMigrationJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([workspaceId, jobId, rowNumber], map: "crm_migration_receipt_row_key")
  @@index([workspaceId, jobId, batchIndex], map: "crm_migration_receipt_batch_idx")
  @@map("crm_migration_row_receipt")
}

// Native session identity, not a new agent run. Payload stays in Eve's durable journal.
model GovernedActionContinuation {
  id String @id
  workspaceId String
  approvalId String
  approval GovernedActionApproval @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Restrict, map: "gac_approval_fk")
  runId String
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict, map: "gac_run_fk")
  versionId String
  rootSessionId String
  sessionId String
  callId String
  toolName String
  payloadDigest String
  nativeRequestId String?
  nativeTurnId String?
  nativeSequence Int?
  status String @default("PREPARED")
  version Int @default(0)
  decision String?
  leaseToken String?
  leaseExpiresAt DateTime?
  nextCheckAt DateTime @default(now())
  transportAdmittedAt DateTime?
  waitingAt DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, approvalId], map: "gac_workspace_approval_key")
  @@unique([workspaceId, runId, callId], map: "gac_workspace_run_call_key")
  @@unique([workspaceId, sessionId, nativeRequestId], map: "gac_workspace_session_request_key")
  @@index([workspaceId, status, nextCheckAt], map: "gac_pending_idx")
  @@index([workspaceId, status, leaseExpiresAt], map: "gac_lease_idx")
}

// Append-only application audit; source tombstones and history are retained.
model CrmMigrationSourceEvent {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  sourceId String @map("source_id")
  actorId String @map("actor_id")
  type String
  details Json
  createdAt DateTime @default(now()) @map("created_at")
  source CrmMigrationSource @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Restrict, map: "crm_source_event_fk")
  @@index([workspaceId, sourceId, createdAt], map: "crm_source_event_source_created_idx")
  @@map("crm_migration_source_event")
}
